
# DO NOT REMOVE THIS LINE AND THE LINES BELOW PWPROTECTID:kqfYCSP0MT
AuthType Basic
AuthName "Restricted Access"
AuthUserFile /home/u348430936/domains/francisferret.fr/public_html/admin/.htpasswd
Require valid-user
# DO NOT REMOVE THIS LINE AND THE LINES ABOVE kqfYCSP0MT:PWPROTECTID

# Empêche le téléchargement direct du fichier de mots de passe et de sa sauvegarde
<Files ".ht*">
  Require all denied
</Files>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|jpg|jpeg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>